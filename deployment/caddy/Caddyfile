:8080 {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle /health {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
