# Store the populated host configuration outside the repository at
# /etc/fitness-app/deployment.env. These paths are not secrets.
FITNESS_DATA_ROOT=/srv/fitness-app
FITNESS_ENV_FILE=/etc/fitness-app/production.env
FITNESS_BACKUP_DIRECTORY=/srv/fitness-app/backups
OCI_BACKUP_NAMESPACE=replace-with-object-storage-namespace
OCI_BACKUP_BUCKET=replace-with-private-bucket-name
OCI_BACKUP_PREFIX=production
